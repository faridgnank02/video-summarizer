# Configuration pour l'API de Production
# Copier ce fichier vers .env et remplir les valeurs

# OpenAI Configuration (REQUIS pour API de production)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# API Configuration
PORT=8000

# AWS Configuration (pour déploiement cloud)
AWS_REGION=us-east-1
DOCKER_IMAGE=your-dockerhub-username/video-summarizer-api:latest
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Legacy configurations (optionnel pour Streamlit UI)
WANDB_API_KEY=your_wandb_api_key_here
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
DEBUG=True
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///video_summarizer.db
REDIS_URL=redis://localhost:6379